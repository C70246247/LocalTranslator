    <string name="ocr_use_accessibility_overlay_title">Use Accessibility Overlay</string>
    <string name="ocr_use_accessibility_overlay_desc">Uses accessibility service to force overlay over status bar. Fixes coordinate offset on some devices. Requires accessibility service.</string>
    <string name="ocr_trans_mode_desc">Auto-fill: Fills recognized text into input box; Full-screen: Displays translation over original text.</string>
    <string name="ocr_trans_mode_paddle_warning">Note: Full-screen translation is not yet available with PaddleOCR and will automatically fallback to auto-fill.</string>
    <string name="ocr_merge_sensitivity_title">OCR Merge Sensitivity: %d%%</string>
    <string name="ocr_merge_sensitivity_desc">Adjust the tendency to merge multiple lines into paragraphs. Higher percentages favor merging adjacent lines to maintain context, but may cause different paragraphs to be incorrectly merged.</string>
    <string name="google_ocr_granularity_title">Google OCR Granularity</string>
    <string name="google_ocr_granularity_desc">Choose the granularity of the engine\'s raw recognition results. Block recognition usually includes the engine\'s built-in paragraph logic, while line recognition relies on this app\'s custom merging algorithm.</string>
    <string name="google_ocr_granularity_line">Line Recognition (Recommended)</string>
    <string name="google_ocr_granularity_block">Block Recognition (Native Logic)</string>
    <string name="ocr_full_screen_bg_opacity_title">Full-screen Background Dimming: %d%%</string>
    <string name="ocr_full_screen_bg_opacity_desc">Adjust the background dimming intensity when entering full-screen translation mode. Lowering it makes the original background clearer, while raising it helps focus on reading translation content.</string>
