    <!-- First Launch Dialog -->
    <string name="first_launch_title">App Permissions &amp; Data Usage Statement</string>
    <string name="first_launch_disclaimer_title">Disclaimer</string>
    <string name="first_launch_content">
        1. Network Usage: This program only uses the network to fetch the offline model list and download models selected by the user.\n\n
        2. Data Processing &amp; Privacy: All core functions, including OCR recognition, are processed locally offline. This program does not upload any data nor collect any form of user logs.\n\n
        3. Data Storage: The program only saves offline models manually selected and downloaded by the user to provide core services. No other personal data is stored or shared.
    </string>
    <string name="first_launch_disclaimer_content">
        Any adverse effects or consequences resulting from the user\'s own use of this program and its related functions (including but not limited to speech-to-text, translation, OCR) are the sole responsibility of the user and have nothing to do with the developer.
    </string>
